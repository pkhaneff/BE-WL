# ===== APP =====
APP_NAME=wishlist
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# ===== DATABASE =====
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ===== JWT =====
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== REDIS =====
REDIS_HOST=
REDIS_PORT=
REDIS_DB=

# ===== S3 =====
# Có thể dùng `S3_*` (khuyến nghị) hoặc `AWS_*` (tương thích)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET_NAME=
# Nếu bucket public/CloudFront, set base URL để trả về URL ổn định
S3_PUBLIC_BASE_URL=
# Nếu bucket private, bật presigned url (mặc định tắt)
S3_USE_PRESIGNED_URLS=false
S3_PRESIGNED_EXPIRES_SECONDS=3600
# Tương thích config bạn đưa: `S3_PREFIX_AUDIO`
S3_PREFIX_AVATAR_USER=
